<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:tp02.Models"
             x:Class="tp02.Views.DetalhesTarefaPage"
             x:DataType="models:Tarefa"
             Title="Detalhes da Tarefa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{Binding Titulo}"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Border Padding="16" Stroke="LightGray" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Descrição" FontAttributes="Bold" />
                    <Label Text="{Binding Descricao}" />

                    <Label Text="Data de criação" FontAttributes="Bold" />
                    <Label Text="{Binding DataCriacao, StringFormat='{0:dd/MM/yyyy}'}" />

                    <Label Text="Prioridade" FontAttributes="Bold" />
                    <Label Text="{Binding Prioridade}"
                           TextColor="{Binding CorPrioridade}"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Editar"
                        Clicked="OnEditarClicked" />
                <Button Grid.Column="1"
                        Text="Excluir"
                        BackgroundColor="#D32F2F"
                        TextColor="White"
                        Clicked="OnExcluirClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>